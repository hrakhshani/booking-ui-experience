{
  "manifest_version": 3,
  "name": "Booking.com Price Calendar",
  "version": "1.0.0",
  "description": "A personal UX layer built on top of Booking.com — showing hotel price stats on the date picker so you can pick the cheapest dates at a glance. A proof-of-concept for building your own browser experiences on any website.",
  "keywords": ["booking.com", "hotel prices", "price calendar", "date picker", "travel", "browser extension", "custom UX", "user experience", "web augmentation"],
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": ["https://www.booking.com/*"],
  "content_scripts": [
    {
      "matches": [
        "https://www.booking.com/",
        "https://www.booking.com/index.html",
        "https://www.booking.com/searchresults*",
        "https://www.booking.com/hotel/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Booking Price Calendar",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
